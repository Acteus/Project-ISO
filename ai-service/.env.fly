# Fly.io Production Environment Configuration

# Flask Configuration
FLASK_PORT=8080
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_AI_SERVICE_URL=https://iso21001-ai-service.fly.dev

# Laravel Integration
LARAVEL_BASE_URL=https://your-cloudways-domain.com
LARAVEL_API_KEY=your-production-api-key-here

# Model Configuration
MODEL_SAVE_PATH=models/
DATA_CACHE_PATH=data/cache/

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai_service.log

# CORS Settings (restrict to your domain)
CORS_ORIGINS=https://your-cloudways-domain.com,https://www.your-cloudways-domain.com

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=32
TIMEOUT_SECONDS=30

# Production Security
SECRET_KEY=your-production-secret-key-here
API_KEY=your-production-api-key-here
